# LLM inference (https://console.groq.com/keys)
GROQ_API_KEY=

# Models
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store
CHROMA_DIR=./data/chroma
COLLECTION_NAME=nurseassist

# Chunking (token-based)
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=75

# Retrieval
TOP_K=5

# Supabase (Auth + Postgres) — leave blank for local dev without Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173
